# BilboMD Docker deployment configuration.
#
# DO NOT commit a filled-in .env (it holds secrets). Generate one with:
#   ./setup-env.sh            (fills the __SECRET__ placeholders below)
# The __...__ values are replaced with `openssl rand -hex 32` output.

# ---- Core ----
NODE_ENV=production
BILBOMD_ENV=production
# Label only (affects minor UI text). Change if you like.
BILBOMD_DEPLOY_SITE=diamond
# URL the browser uses to reach the UI. Must match how you access it, because it
# drives CORS + login-cookie security. Local test = http://localhost:8080.
# For a remote/team host put the real http(s) URL here (see README).
BILBOMD_URL=http://localhost:8080
BILBOMD_FQDN=localhost
CORS_ALLOWED_ORIGINS=http://localhost:8080
BILBOMD_UI_PORT=8080

# ---- Secrets (filled by setup-env.sh) ----
ACCESS_TOKEN_SECRET=__ACCESS_TOKEN_SECRET__
REFRESH_TOKEN_SECRET=__REFRESH_TOKEN_SECRET__
SESSION_SECRET=__SESSION_SECRET__
HASH_IP_SALT=__HASH_IP_SALT__

# ---- MongoDB ----
MONGO_USERNAME=bilbomd-backend-user
MONGO_PASSWORD=__MONGO_PASSWORD__
MONGO_HOSTNAME=mongodb
MONGO_PORT=27017
MONGO_DB=bilbomd
MONGO_AUTH_SRC=admin

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Shared paths (inside the containers) ----
DATA_VOL=/bilbomd/uploads
BILBOMD_LOGS=/bilbomd/logs
EXAMPLE_DATA=/app/examples
# Writable HOME + caches (worker uses tmpfs /tmp). Required for micromamba/matplotlib.
HOME=/tmp
MPLCONFIGDIR=/tmp/matplotlib
XDG_CACHE_HOME=/tmp/cache

# ---- Worker execution (de-nesting: run pipelines in-container, no nested docker) ----
CARBONARA_EXEC=inprocess
AUTOMD_SAXS_BIN=/opt/envs/openmm/bin/automd-saxs

# ---- Science tool paths (baked into the image; set for belt-and-braces) ----
CHARMM_TOPOLOGY=/app/scripts/bilbomd_top_par_files.str
CHARMM_TEMPLATES=/app/build/templates/bilbomd
CHARMM=/usr/local/bin/charmm
FOXS=/usr/bin/foxs
MULTIFOXS=/usr/bin/multi_foxs

# ---- Feature flags ----
ENABLE_BILBOMD_CARBONARA=true
ENABLE_BILBOMD_SANS=false
ENABLE_BILBOMD_MULTI=false
ENABLE_BILBOMD_ALPHAFOLD=true

# ---- Email (off) ----
SEND_EMAIL_NOTIFICATIONS=false
SEND_EMAIL_USER=bilbomd@example.invalid

# ---- ORCID (off — using the OTP dev login; see README) ----
ORCID_AUTH_ENABLED=false
ORCID_ISSUER=https://orcid.org
ORCID_CLIENT_ID=placeholder-client-id
ORCID_CLIENT_SECRET=placeholder
ORCID_REDIRECT_URI=http://localhost/api/v1/auth/orcid/callback

# ---- NERSC off (dummy paths so required-env checks pass) ----
USE_NERSC=false
SFAPI_URL=https://example.invalid/api/v1
SCRIPT_DIR=/tmp/nersc/scripts
UPLOAD_DIR=/tmp/nersc/uploads
WORK_DIR=/tmp/nersc/work
PREPARE_CHARMM_SLURM_SCRIPT=/tmp/nersc/gen-charmm.py
PREPARE_OMM_SLURM_SCRIPT=/tmp/nersc/gen-omm.py
CP2CFS_SCRIPT=/tmp/nersc/cp2cfs.sh
